{
  "enabled": true,
  "mode": "observe",
  "zero_stage": 2,
  "failure_policy": "raise",
  "importance": {
    "enabled": true,
    "algorithm": "pretrained_delta_topk",
    "warmup_steps": 1,
    "topk_ratio": 0.1,
    "comparison_chunk_rows": 4096,
    "sparse_backward": true,
    "sparse_backward_min_tokens": 1,
    "sparse_backward_min_output_features": 1024,
    "output_path": null
  },
  "hybrid_update": {
    "enabled": true,
    "update_interval": 4,
    "accumulation_device": "gpu",
    "dense_boundary_enabled": true,
    "double_buffer": true,
    "second_gradient_reduction": "mean",
    "max_async_lag": 2,
    "overdue_policy": "wait",
    "compressed_collective_shadow": false,
    "compressed_bucket_bytes": 134217728,
    "parity_atol": 0.001,
    "parity_rtol": 0.001,
    "zero2_takeover": true,
    "pt_reserved_cores_perc": 0.25
  },
  "telemetry": {
    "log_interval": 100,
    "parameter_events": true,
    "bucket_events": true,
    "host_timing": true,
    "device_timing": false,
    "memory_metrics": true,
    "distributed_summary": false,
    "rank_mode": "rank0_local",
    "debug_event_buffer_size": 0,
    "max_parameter_name_length": 128,
    "jsonl_path": null,
    "csv_path": null
  }
}
